# Modèle Linux : certificat à installer AVANT activation. Adapter les chemins.
server {
    listen 80;
    server_name burnt.gmccgabon.com;
    return 301 https://burnt.gmccgabon.com$request_uri;
}
server {
    listen 443 ssl;
    server_name burnt.gmccgabon.com;
    ssl_certificate /etc/letsencrypt/live/burnt.gmccgabon.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/burnt.gmccgabon.com/privkey.pem;
    root /var/www/burnt-empty;
    client_max_body_size 13m;
    location / {
        proxy_pass http://127.0.0.1:4310;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
}
